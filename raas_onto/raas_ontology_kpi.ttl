raas:RetentionRate_W1_NewUser a raas:MetricVariant ;
    rdfs:label "신규사용자 W1유지율"@ko ;
    rdfs:comment "신규사용자가 1주 후 재방문 비율(%)"@ko ;
    raas:ofMetric raas:RetentionRate ;
    raas:hasWindow raas:Window_W1 ;
    raas:hasCohort raas:Cohort_NewUser ;
    raas:fieldName "new_w1_ret" .

raas:RetentionRate_M1_NewUser a raas:MetricVariant ;
    rdfs:label "신규사용자 M1유지율"@ko ;
    rdfs:comment "신규사용자가 1개월 후 재방문 비율(%)"@ko ;
    raas:ofMetric raas:RetentionRate ;
