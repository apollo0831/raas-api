raas:RetentionRate_D7_NewUser a raas:MetricVariant ;
    rdfs:label "신규사용자 D7유지율"@ko ;
    rdfs:comment "신규사용자가 7일 후 재방문 비율(%)"@ko ;
    raas:ofMetric raas:RetentionRate ;
    raas:hasWindow raas:Window_D7 ;
    raas:hasCohort raas:Cohort_NewUser ;
