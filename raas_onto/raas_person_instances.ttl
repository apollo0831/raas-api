# =============================================================================
# Part B. RegularGuest 인스턴스 (고정 게스트)
# =============================================================================
# 정책: F05는 Policy_RegularPlusGuest. '/' 앞이 고정 게스트.
# CSV에서 추출된 5/2까지 등장한 RegularGuest 후보들:
#   - 김젬마, 정상근, 미친감성, 김헌, 피터, 이석무
# 정상근은 여러 번 반복되어 분명한 RegularGuest.
# 다른 인물들은 1회만 등장 — 이들도 RegularGuest인지 일회성인지는 도메인 확인 필요.
#
# L07 이숙영의 러브FM의 이재익은 사용자 도메인 정보 추가:
#   - 4/29, 4/30, 5/01 3일 연속 출연 (CSV 검증)
#   - 사용자 확정: "게스트 분석에서 제외" → 사실상 RegularGuest
# 
# 안전 원칙: 여러 회차에 등장한 것만 확실한 RegularGuest로 인스턴스화.
# 그 외는 향후 추가.

raas:Person_JungSangGeun a raas:Person ;
    rdfs:label "정상근"@ko ;
    raas:personName "정상근"@ko ;
    rdfs:comment "F05 김영철의 파워FM 고정 게스트. CSV에서 3회 이상 등장."@ko .

raas:F05 raas:hasRegularGuest raas:Person_JungSangGeun .

raas:Person_LeeJaeIk a raas:Person ;
    rdfs:label "이재익"@ko ;
    raas:personName "이재익"@ko ;
    rdfs:comment "L07 이숙영의 러브FM 고정 출연자. 4/29, 4/30, 5/01 연속 출연 확인. 사용자 도메인 정보로 RegularGuest 분류."@ko .

raas:L07 raas:hasRegularGuest raas:Person_LeeJaeIk .


# =============================================================================
# Part C. 추가 속성 (Phase 2-C-4 선행)
# =============================================================================

raas:hasRegularGuest a <http://www.w3.org/2002/07/owl#ObjectProperty> ;
    rdfs:domain raas:Program ;
    rdfs:range raas:Person ;
    rdfs:label "고정 게스트"@ko ;
    rdfs:comment "프로그램의 고정 출연 게스트. 일회성 게스트가 아닌 정기 출연자."@ko .


# =============================================================================
# 미인스턴스화 항목 (향후 도메인 검증 후 추가 예정)
# =============================================================================
# 사용자 도메인 정보 추가분 (Phase 2-C-3 Step 2 보강):
#   F03 파워 스테이션: DJ 없음 (AutomatedProgram)
#   F10 황제파워: 황제성
#   L01 YESTERDAY 20: DJ 없음 (AutomatedProgram)
#   L11 인생은 오디션: 이상미
# 
# 향후 추가 예정:
# - F02 애프터 클럽: 요일별 RotatingHost 4명 — Episode 인스턴스화 시 함께
#   현재 알려진 후보: DJ 푸디토리움, DJ 윤덕원, DJ 임헌일, DJ 구름
# - L02 Love20(재), L03 OLDIES 20(재): 재방송 (원 프로그램의 진행자 — 별도 표현 필요)


# =============================================================================
# Part D. 추가 MainHost (사용자 도메인 정보 보강)
# =============================================================================

raas:Person_HwangJaeSung a raas:Person ;
    rdfs:label "황제성"@ko ;
    raas:personName "황제성"@ko ;
    rdfs:comment "F10 황제파워의 진행자. 프로그램명 '황제파워'는 진행자명 황제성에서 유래."@ko .
raas:F10 raas:hasMainHost raas:Person_HwangJaeSung .

raas:Person_LeeSangMi a raas:Person ;
    rdfs:label "이상미"@ko ;
    raas:personName "이상미"@ko ;
    raas:stageName "DJ 이상미"@ko ;
    rdfs:comment "L11 인생은 오디션 진행자."@ko .
raas:L11 raas:hasMainHost raas:Person_LeeSangMi .


# =============================================================================
# Part E. ProgramType 분류 — 모든 Program에 적용
# =============================================================================
# AutomatedProgram (진행자 없는 자동 음악 프로그램)
raas:F03 raas:hasProgramType raas:AutomatedProgram .  # 파워 스테이션
raas:L01 raas:hasProgramType raas:AutomatedProgram .  # YESTERDAY 20

# 나머지는 모두 HostedProgram (재방송 포함 — 재방송도 원본은 HostedProgram)
raas:F01 raas:hasProgramType raas:HostedProgram .
raas:F02 raas:hasProgramType raas:HostedProgram .
raas:F04 raas:hasProgramType raas:HostedProgram .
raas:F05 raas:hasProgramType raas:HostedProgram .
raas:F06 raas:hasProgramType raas:HostedProgram .
raas:F07 raas:hasProgramType raas:HostedProgram .
raas:F08 raas:hasProgramType raas:HostedProgram .
raas:F09 raas:hasProgramType raas:HostedProgram .
raas:F10 raas:hasProgramType raas:HostedProgram .
raas:F11 raas:hasProgramType raas:HostedProgram .
raas:F12 raas:hasProgramType raas:HostedProgram .
raas:F13 raas:hasProgramType raas:HostedProgram .
raas:L02 raas:hasProgramType raas:HostedProgram .  # 재방송 (원본은 Hosted)
raas:L03 raas:hasProgramType raas:HostedProgram .  # 재방송 (원본은 Hosted)
raas:L05 raas:hasProgramType raas:HostedProgram .
raas:L06 raas:hasProgramType raas:HostedProgram .
raas:L07 raas:hasProgramType raas:HostedProgram .
raas:L08 raas:hasProgramType raas:HostedProgram .
