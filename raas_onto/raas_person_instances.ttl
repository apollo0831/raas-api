raas:L10 raas:hasProgramType raas:HostedProgram .
raas:L11 raas:hasProgramType raas:HostedProgram .
raas:L12 raas:hasProgramType raas:HostedProgram .
raas:L13 raas:hasProgramType raas:HostedProgram .
raas:L14 raas:hasProgramType raas:HostedProgram .
raas:L15 raas:hasProgramType raas:HostedProgram .
raas:M05 raas:hasProgramType raas:HostedProgram .
raas:M07 raas:hasProgramType raas:HostedProgram .
raas:M10 raas:hasProgramType raas:HostedProgram .
raas:M11 raas:hasProgramType raas:HostedProgram .


