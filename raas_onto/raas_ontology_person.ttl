raas:F07 raas:hasMainHost raas:Person_ParkHaSun .

raas:Person_JuHyunYoung a raas:Person ;
    rdfs:label "주현영"@ko ;
    raas:personName "주현영"@ko ;
    raas:personOccupation "배우, 방송인"@ko .
raas:F08 raas:hasMainHost raas:Person_JuHyunYoung .

