    | xyseries DATE PGM_CODE metric_value
    | fields DATE T00 F00 L00 G00 P00 F* L* M*
    | untable DATE PGM_CODE metric_value
    | eval PGM_CODE=upper(PGM_CODE), metric_type="engage_rate_mon",
           metric_value=tonumber(metric_value), DATE_MON=DATE,
           _time=strptime(DATE,"%Y/%m/%d"), today_value=metric_value
]

`comment("--- 습관형성률 월간 ---")`
| append maxout=200000 [
    | inputlookup program_newuser_funnel_mon.csv
    | search TYPE=3D7D_1M
    | fields DATE T00 F00 L00 G00 P00 F* L* M*
    | untable DATE PGM_CODE num_val
    | eval num_val=coalesce(tonumber(num_val), 0)
    | join type=left max=1 DATE PGM_CODE [
        | inputlookup program_newuser_funnel_mon.csv
        | search TYPE=ALL
        | fields DATE T00 F00 L00 G00 P00 F* L* M*
        | untable DATE PGM_CODE dau_val
        | eval dau_val=coalesce(tonumber(dau_val), 0)
    ]
    | eval metric_value=if(dau_val>0, round(num_val/dau_val*100,1), 0)
    | eval PGM_CODE=upper(PGM_CODE)
    | xyseries DATE PGM_CODE metric_value
    | fields DATE T00 F00 L00 G00 P00 F* L* M*
    | untable DATE PGM_CODE metric_value
    | eval PGM_CODE=upper(PGM_CODE), metric_type="habit_rate_mon",
           metric_value=tonumber(metric_value), DATE_MON=DATE,
           _time=strptime(DATE,"%Y/%m/%d"), today_value=metric_value
]

`comment("================================================================")`
`comment("=== [4] 전주 비교값 생성 (appendpipe) ===")`
`comment("================================================================")`

| appendpipe [
    | where isnotnull(metric_value)
    | eval shift_days=case(
        metric_type=="dau_r30_day", 30,
        true(), 7
    )
    | eval DATE=strftime(relative_time(_time, "+".shift_days."d"),"%Y/%m/%d"),
           prev_week_value=metric_value
    | fields DATE PGM_CODE metric_type prev_week_value
]

`comment("--- 전일값(+1d 시프트): dau_day 전용 — dau_d2 계산용 ---")`
| appendpipe [
    | where isnotnull(metric_value) AND metric_type="dau_day"
    | eval DATE=strftime(relative_time(_time,"+1d"),"%Y/%m/%d"),
           yday_value=metric_value
    | fields DATE PGM_CODE metric_type yday_value
]

| stats max(today_value)     as today_value
        max(prev_week_value) as prev_week_value
        max(yday_value)      as yday_value
        max(DATE_WEEK)       as DATE_WEEK
        max(DATE_MON)        as DATE_MON
  by DATE PGM_CODE metric_type
| where isnotnull(today_value)

`comment("================================================================")`
`comment("=== [5] 날짜 필터 + DATE 분기 보존 ===")`
`comment("필터 통과 후 metric_type 기준으로 DATE를 분리 보존")`
`comment("  일간 → DATE_DAY(=DATE) / 주간 → DATE_WEEK / 월간 → DATE_MON")`
`comment("이후 [7] stats by PGM_CODE 에서 max()로 합쳐져 1행으로 만들어짐")`
`comment("================================================================")`

| eval date_day  = strftime(relative_time(now(),"-1d@d"),   "%Y/%m/%d")
| eval date_week = strftime(relative_time(now(),"-1w@w1"),  "%Y/%m/%d")
| eval date_mon  = strftime(relative_time(now(),"-1mon@mon"),"%Y/%m/%d")

| where (
    (match(metric_type,"_day")       AND DATE=date_day)  OR
    (match(metric_type,"_week")      AND DATE=date_week) OR
    (match(metric_type,"_mon")       AND DATE=date_mon)
)

`comment("--- DATE를 각 기간 컬럼으로 분리 보존 (null이면 stats max()에서 무시됨) ---")`
| eval DATE_DAY  = if(match(metric_type,"_day"),  DATE, null())
| eval DATE_WEEK = if(match(metric_type,"_week"), DATE, coalesce(DATE_WEEK, null()))
| eval DATE_MON  = if(match(metric_type,"_mon"),  DATE, coalesce(DATE_MON,  null()))

| fields - date_day date_week date_mon

`comment("================================================================")`
`comment("=== [6] metric_type → 컬럼 피벗 ===")`
`comment("================================================================")`

`comment("--- 일간 ---")`
| eval dau       = if(metric_type="dau_day",         today_value, null())
| eval dau_prev          = if(metric_type="dau_day",         prev_week_value, null())
| eval dau_d2        = if(metric_type="dau_day",         yday_value, null())
| eval dau_r7       = if(metric_type="dau_r7_day",         today_value, null())
| eval dau_r7_prev          = if(metric_type="dau_r7_day",         prev_week_value, null())
| eval dau_r30       = if(metric_type="dau_r30_day",         today_value, null())
| eval dau_r30_prev          = if(metric_type="dau_r30_day",         prev_week_value, null())
| eval new       = if(metric_type="new_day",         today_value, null())
| eval new_prev          = if(metric_type="new_day",         prev_week_value, null())
| eval react     = if(metric_type="react_day",       today_value, null())
| eval react_prev        = if(metric_type="react_day",       prev_week_value, null())
| eval react_rate      = if(metric_type="react_rate_day",  today_value, null())
| eval react_rate_prev   = if(metric_type="react_rate_day",  prev_week_value, null())
| eval churn_rate      = if(metric_type="churn_rate_day",       today_value, null())
| eval churn_rate_prev   = if(metric_type="churn_rate_day",       prev_week_value, null())
| eval dau_1min        = if(metric_type="dau_1min_day",    today_value, null())
| eval dau_1min_prev     = if(metric_type="dau_1min_day",    prev_week_value, null())
| eval dau_10min       = if(metric_type="dau_10min_day",   today_value, null())
| eval dau_10min_prev    = if(metric_type="dau_10min_day",   prev_week_value, null())
| eval d1_ret          = if(metric_type="d1_ret_day",      today_value, null())
| eval d1_ret_prev       = if(metric_type="d1_ret_day",      prev_week_value, null())
| eval d7_ret          = if(metric_type="d7_ret_day",      today_value, null())
| eval d7_ret_prev       = if(metric_type="d7_ret_day",      prev_week_value, null())
| eval new_d1_ret      = if(metric_type="new_d1_ret_day",   today_value, null())
| eval new_d1_ret_prev   = if(metric_type="new_d1_ret_day",   prev_week_value, null())
| eval new_d7_ret      = if(metric_type="new_d7_ret_day",   today_value, null())
| eval new_d7_ret_prev   = if(metric_type="new_d7_ret_day",   prev_week_value, null())
| eval new_w1_ret      = if(metric_type="new_w1_ret_week",  today_value, null())
| eval new_w1_ret_prev   = if(metric_type="new_w1_ret_week",  prev_week_value, null())
| eval new_m1_ret      = if(metric_type="new_m1_ret_mon",   today_value, null())
| eval new_m1_ret_prev   = if(metric_type="new_m1_ret_mon",   prev_week_value, null())
| eval engage_rate     = if(metric_type="engage_rate_day",      today_value, null())
| eval engage_rate_prev  = if(metric_type="engage_rate_day",      prev_week_value, null())
| eval habit_rate      = if(metric_type="habit_rate_day",       today_value, null())
| eval habit_rate_prev   = if(metric_type="habit_rate_day",       prev_week_value, null())

`comment("--- 주간 ---")`
| eval wau           = if(metric_type="wau_week",          today_value, null())
| eval wau_prev        = if(metric_type="wau_week",          prev_week_value, null())
| eval new_week           = if(metric_type="new_week",          today_value, null())
| eval new_week_prev        = if(metric_type="new_week",          prev_week_value, null())
| eval react_week         = if(metric_type="react_week",        today_value, null())
| eval react_week_prev      = if(metric_type="react_week",        prev_week_value, null())
| eval react_rate_week    = if(metric_type="react_rate_week",   today_value, null())
| eval react_rate_week_prev = if(metric_type="react_rate_week",   prev_week_value, null())
| eval churn_rate_week         = if(metric_type="churn_rate_week",        today_value, null())
| eval churn_rate_week_prev      = if(metric_type="churn_rate_week",        prev_week_value, null())
| eval wau_1min           = if(metric_type="wau_1min_week",     today_value, null())
| eval wau_1min_prev        = if(metric_type="wau_1min_week",     prev_week_value, null())
| eval wau_10min          = if(metric_type="wau_10min_week",    today_value, null())
| eval wau_10min_prev       = if(metric_type="wau_10min_week",    prev_week_value, null())
| eval w1_ret             = if(metric_type="w1_ret_week",       today_value, null())
| eval w1_ret_prev          = if(metric_type="w1_ret_week",       prev_week_value, null())
| eval engage_rate_week        = if(metric_type="engage_rate_week",       today_value, null())
| eval engage_rate_week_prev     = if(metric_type="engage_rate_week",       prev_week_value, null())
| eval habit_rate_week         = if(metric_type="habit_rate_week",        today_value, null())
| eval habit_rate_week_prev      = if(metric_type="habit_rate_week",        prev_week_value, null())

`comment("--- 월간 ---")`
| eval mau            = if(metric_type="mau_mon",           today_value, null())
| eval mau_prev         = if(metric_type="mau_mon",           prev_week_value, null())
| eval new_mon            = if(metric_type="new_mon",           today_value, null())
| eval new_mon_prev         = if(metric_type="new_mon",           prev_week_value, null())
| eval react_mon          = if(metric_type="react_mon",         today_value, null())
| eval react_mon_prev       = if(metric_type="react_mon",         prev_week_value, null())
| eval react_rate_mon     = if(metric_type="react_rate_mon",    today_value, null())
| eval react_rate_mon_prev  = if(metric_type="react_rate_mon",    prev_week_value, null())
| eval churn_rate_mon          = if(metric_type="churn_rate_mon",         today_value, null())
| eval churn_rate_mon_prev       = if(metric_type="churn_rate_mon",         prev_week_value, null())
| eval mau_1min           = if(metric_type="mau_1min_mon",      today_value, null())
| eval mau_1min_prev        = if(metric_type="mau_1min_mon",      prev_week_value, null())
| eval mau_10min          = if(metric_type="mau_10min_mon",     today_value, null())
| eval mau_10min_prev       = if(metric_type="mau_10min_mon",     prev_week_value, null())
| eval m1_ret             = if(metric_type="m1_ret_mon",        today_value, null())
| eval m1_ret_prev          = if(metric_type="m1_ret_mon",        prev_week_value, null())
| eval engage_rate_mon         = if(metric_type="engage_rate_mon",        today_value, null())
| eval engage_rate_mon_prev      = if(metric_type="engage_rate_mon",        prev_week_value, null())
| eval habit_rate_mon          = if(metric_type="habit_rate_mon",         today_value, null())
| eval habit_rate_mon_prev       = if(metric_type="habit_rate_mon",         prev_week_value, null())


`comment("================================================================")`
`comment("=== [7] PGM_CODE별 집계 ===")`
`comment("================================================================")`

| stats
    `comment("--- 날짜: DATE=일간전일 / DATE_WEEK=전주월요일 / DATE_MON=전월1일 ---")`
    max(DATE_DAY)  as DATE
    max(DATE_WEEK) as DATE_WEEK
    max(DATE_MON)  as DATE_MON
    `comment("--- 일간 ---")`
    max(dau)       as dau       max(dau_prev)            as dau_prev
    max(dau_d2)        as dau_d2
    max(dau_r7)       as dau_r7       max(dau_r7_prev)            as dau_r7_prev
    max(dau_r30)       as dau_r30       max(dau_r30_prev)            as dau_r30_prev
    max(new)       as new       max(new_prev)            as new_prev
    max(react)     as react     max(react_prev)          as react_prev
    max(react_rate)      as react_rate      max(react_rate_prev)     as react_rate_prev
    max(churn_rate)      as churn_rate      max(churn_rate_prev)     as churn_rate_prev
    max(dau_1min)        as dau_1min        max(dau_1min_prev)       as dau_1min_prev
    max(dau_10min)       as dau_10min       max(dau_10min_prev)      as dau_10min_prev
    max(d1_ret)          as d1_ret          max(d1_ret_prev)         as d1_ret_prev
    max(d7_ret)          as d7_ret          max(d7_ret_prev)         as d7_ret_prev
    max(new_d1_ret)      as new_d1_ret      max(new_d1_ret_prev)     as new_d1_ret_prev
    max(new_d7_ret)      as new_d7_ret      max(new_d7_ret_prev)     as new_d7_ret_prev
    max(new_w1_ret)      as new_w1_ret      max(new_w1_ret_prev)     as new_w1_ret_prev
    max(new_m1_ret)      as new_m1_ret      max(new_m1_ret_prev)     as new_m1_ret_prev
    max(engage_rate)     as engage_rate     max(engage_rate_prev)    as engage_rate_prev
    max(habit_rate)      as habit_rate      max(habit_rate_prev)     as habit_rate_prev
    `comment("--- 주간 ---")`
    max(wau)        as wau        max(wau_prev)       as wau_prev
    max(new_week)        as new_week        max(new_week_prev)       as new_week_prev
    max(react_week)      as react_week      max(react_week_prev)     as react_week_prev
    max(react_rate_week) as react_rate_week max(react_rate_week_prev) as react_rate_week_prev
    max(churn_rate_week)      as churn_rate_week      max(churn_rate_week_prev)     as churn_rate_week_prev
    max(wau_1min)        as wau_1min        max(wau_1min_prev)       as wau_1min_prev
    max(wau_10min)       as wau_10min       max(wau_10min_prev)      as wau_10min_prev
    max(w1_ret)          as w1_ret          max(w1_ret_prev)         as w1_ret_prev
    max(engage_rate_week)     as engage_rate_week     max(engage_rate_week_prev)    as engage_rate_week_prev
    max(habit_rate_week)      as habit_rate_week      max(habit_rate_week_prev)     as habit_rate_week_prev
    `comment("--- 월간 ---")`
    max(mau)         as mau         max(mau_prev)        as mau_prev
    max(new_mon)         as new_mon         max(new_mon_prev)        as new_mon_prev
    max(react_mon)       as react_mon       max(react_mon_prev)      as react_mon_prev
    max(react_rate_mon)  as react_rate_mon  max(react_rate_mon_prev) as react_rate_mon_prev
    max(churn_rate_mon)       as churn_rate_mon       max(churn_rate_mon_prev)      as churn_rate_mon_prev
    max(mau_1min)        as mau_1min        max(mau_1min_prev)       as mau_1min_prev
    max(mau_10min)       as mau_10min       max(mau_10min_prev)      as mau_10min_prev
    max(m1_ret)          as m1_ret          max(m1_ret_prev)         as m1_ret_prev
    max(engage_rate_mon)      as engage_rate_mon      max(engage_rate_mon_prev)     as engage_rate_mon_prev
    max(habit_rate_mon)       as habit_rate_mon       max(habit_rate_mon_prev)      as habit_rate_mon_prev
  by PGM_CODE

`comment("================================================================")`
`comment("=== [8] 파생 지표 계산 ===")`
`comment("================================================================")`

`comment("--- 일간 파생 ---")`
| eval deep_rate        = if(dau_1min>0,    round(dau_10min/dau_1min*100,1),       null())
| eval deep_rate_prev     = if(dau_1min_prev>0, round(dau_10min_prev/dau_1min_prev*100,1), null())
| eval deep_rate_diff   = if(isnotnull(deep_rate) AND isnotnull(deep_rate_prev), round(deep_rate-deep_rate_prev,1), null())
| eval dau_chg          = if(dau_prev>0,      round((dau-dau_prev)/dau_prev*100,1),       null())
| eval new_chg          = if(new_prev>0,      round((new-new_prev)/new_prev*100,1),        null())
| eval react_chg        = if(react_prev>0,    round((react-react_prev)/react_prev*100,1),  null())
| eval churn_rate_diff       = if(isnotnull(churn_rate)  AND isnotnull(churn_rate_prev),  round(churn_rate-churn_rate_prev,1),   null())
| eval react_rate_diff  = if(isnotnull(react_rate)  AND isnotnull(react_rate_prev),  round(react_rate-react_rate_prev,1),   null())
| eval d1_ret_diff          = if(isnotnull(d1_ret)      AND isnotnull(d1_ret_prev),      round(d1_ret-d1_ret_prev,1),           null())
| eval d7_ret_diff          = if(isnotnull(d7_ret)      AND isnotnull(d7_ret_prev),      round(d7_ret-d7_ret_prev,1),           null())
| eval new_d1_ret_diff      = if(isnotnull(new_d1_ret)  AND isnotnull(new_d1_ret_prev),  round(new_d1_ret-new_d1_ret_prev,1),   null())
| eval new_d7_ret_diff      = if(isnotnull(new_d7_ret)  AND isnotnull(new_d7_ret_prev),  round(new_d7_ret-new_d7_ret_prev,1),   null())
| eval new_w1_ret_diff      = if(isnotnull(new_w1_ret)  AND isnotnull(new_w1_ret_prev),  round(new_w1_ret-new_w1_ret_prev,1),   null())
| eval new_m1_ret_diff      = if(isnotnull(new_m1_ret)  AND isnotnull(new_m1_ret_prev),  round(new_m1_ret-new_m1_ret_prev,1),   null())
| eval engage_rate_diff      = if(isnotnull(engage_rate) AND isnotnull(engage_rate_prev), round(engage_rate-engage_rate_prev,1), null())
| eval habit_rate_diff       = if(isnotnull(habit_rate)  AND isnotnull(habit_rate_prev),  round(habit_rate-habit_rate_prev,1),   null())
| eval new_share          = if(dau>0, round(new/dau*100,1),   null())
| eval react_share        = if(dau>0, round(react/dau*100,1), null())

| eval dau_1min_chg  = if(dau_1min_prev>0,  round((dau_1min  - dau_1min_prev)  / dau_1min_prev  * 100, 1), null())
| eval dau_10min_chg = if(dau_10min_prev>0, round((dau_10min - dau_10min_prev) / dau_10min_prev * 100, 1), null())
| eval wau_1min_chg  = if(wau_1min_prev>0,  round((wau_1min  - wau_1min_prev)  / wau_1min_prev  * 100, 1), null())
| eval wau_10min_chg = if(wau_10min_prev>0, round((wau_10min - wau_10min_prev) / wau_10min_prev * 100, 1), null())
| eval mau_1min_chg  = if(mau_1min_prev>0,  round((mau_1min  - mau_1min_prev)  / mau_1min_prev  * 100, 1), null())
| eval mau_10min_chg = if(mau_10min_prev>0, round((mau_10min - mau_10min_prev) / mau_10min_prev * 100, 1), null())
| eval dau_r7_chg    = if(dau_r7_prev>0,    round((dau_r7    - dau_r7_prev)    / dau_r7_prev    * 100, 1), null())
| eval dau_r30_chg   = if(dau_r30_prev>0,   round((dau_r30   - dau_r30_prev)   / dau_r30_prev   * 100, 1), null())

`comment("--- 주간 파생 ---")`
| eval deep_rate_week      = if(wau_1min>0,    round(wau_10min/wau_1min*100,1),       null())
| eval deep_rate_week_prev   = if(wau_1min_prev>0, round(wau_10min_prev/wau_1min_prev*100,1), null())
| eval deep_rate_week_diff = if(isnotnull(deep_rate_week) AND isnotnull(deep_rate_week_prev), round(deep_rate_week-deep_rate_week_prev,1), null())
| eval wau_chg        = if(wau_prev>0,   round((wau-wau_prev)/wau_prev*100,1),      null())
| eval new_week_chg        = if(new_week_prev>0,   round((new_week-new_week_prev)/new_week_prev*100,1),        null())
| eval react_week_chg      = if(react_week_prev>0, round((react_week-react_week_prev)/react_week_prev*100,1),  null())
| eval churn_rate_week_diff      = if(isnotnull(churn_rate_week)      AND isnotnull(churn_rate_week_prev),      round(churn_rate_week-churn_rate_week_prev,1),           null())
| eval react_rate_week_diff = if(isnotnull(react_rate_week) AND isnotnull(react_rate_week_prev), round(react_rate_week-react_rate_week_prev,1), null())
| eval w1_ret_diff              = if(isnotnull(w1_ret)          AND isnotnull(w1_ret_prev),          round(w1_ret-w1_ret_prev,1),                   null())
| eval engage_rate_week_diff     = if(isnotnull(engage_rate_week)     AND isnotnull(engage_rate_week_prev),     round(engage_rate_week-engage_rate_week_prev,1),          null())
| eval habit_rate_week_diff      = if(isnotnull(habit_rate_week)      AND isnotnull(habit_rate_week_prev),      round(habit_rate_week-habit_rate_week_prev,1),            null())
| eval new_week_share         = if(wau>0, round(new_week/wau*100,1),   null())
| eval react_week_share       = if(wau>0, round(react_week/wau*100,1), null())

`comment("--- 월간 파생 ---")`
| eval deep_rate_mon      = if(mau_1min>0,    round(mau_10min/mau_1min*100,1),       null())
| eval deep_rate_mon_prev   = if(mau_1min_prev>0, round(mau_10min_prev/mau_1min_prev*100,1), null())
| eval deep_rate_mon_diff = if(isnotnull(deep_rate_mon) AND isnotnull(deep_rate_mon_prev), round(deep_rate_mon-deep_rate_mon_prev,1), null())
| eval mau_chg        = if(mau_prev>0,   round((mau-mau_prev)/mau_prev*100,1),      null())
| eval new_mon_chg        = if(new_mon_prev>0,   round((new_mon-new_mon_prev)/new_mon_prev*100,1),        null())
| eval react_mon_chg      = if(react_mon_prev>0, round((react_mon-react_mon_prev)/react_mon_prev*100,1),  null())
| eval churn_rate_mon_diff      = if(isnotnull(churn_rate_mon)      AND isnotnull(churn_rate_mon_prev),      round(churn_rate_mon-churn_rate_mon_prev,1),           null())
| eval react_rate_mon_diff = if(isnotnull(react_rate_mon) AND isnotnull(react_rate_mon_prev), round(react_rate_mon-react_rate_mon_prev,1), null())
| eval m1_ret_diff             = if(isnotnull(m1_ret)         AND isnotnull(m1_ret_prev),         round(m1_ret-m1_ret_prev,1),                 null())
| eval engage_rate_mon_diff     = if(isnotnull(engage_rate_mon)     AND isnotnull(engage_rate_mon_prev),     round(engage_rate_mon-engage_rate_mon_prev,1),          null())
| eval habit_rate_mon_diff      = if(isnotnull(habit_rate_mon)      AND isnotnull(habit_rate_mon_prev),      round(habit_rate_mon-habit_rate_mon_prev,1),            null())
| eval new_mon_share         = if(mau>0, round(new_mon/mau*100,1),   null())
| eval react_mon_share       = if(mau>0, round(react_mon/mau*100,1), null())


`comment("================================================================")`
`comment("=== [9] 편성 정보 JOIN ===")`
`comment("편성 고정 정보: PGM_NAME, STIME (BROADPLAN.csv)")`
`comment("당일 편성 정보: program_title, guestname, daily_corner, weekly_corner (broadplan index)")`
`comment("join_key = DATE||PGM_CODE 로 당일 편성과 매칭")`
`comment("================================================================")`

| eval join_key=DATE."||".PGM_CODE

`comment("--- 프로그램명/방송시작시간: BROADPLAN.csv 고정 정보 ---")`
| join type=left max=0 PGM_CODE [
    | inputlookup BROADPLAN.csv
    | eval CHN=case(CHN="AM","LM", CHN="FM","FM", CHN="GM","GM", true(), CHN)
    | search IS_END="N" CHN=*
    | eval SEQ=tostring(SEQ)
    | eval SEQ=if(len(SEQ)=1, "0".SEQ, SEQ)
    | eval PGM_CODE=upper(SEQ)
    | stats values(PGM_NAME) as PGM_NAME values(STIME) as STIME by PGM_CODE
    | eval PGM_NAME=mvindex(PGM_NAME,0), STIME=mvindex(STIME,0)
    | fields PGM_CODE PGM_NAME STIME
]

`comment("--- 당일 방송 편성 상세: 제목/게스트/코너 (broadplan index, 전일 기준) ---")`
| join type=left max=0 join_key [
    search index=broadplan
    [| makeresults
        | eval PROGRAM_CODE=""
        | eval earliest="-1d@d"
        | eval latest="@d"
        | eval earliest=if(PROGRAM_CODE!="F01", earliest, earliest-3600)
        | eval latest=if(PROGRAM_CODE!="F01", latest, latest-3600)
        | return earliest, latest]
    | eval DATE=strftime(_time, "%Y/%m/%d")
    | eval date_mday=ltrim(strftime(_time,"%d"),"0"),
           date_month=lower(strftime(_time,"%B")),
           date_wday=lower(strftime(_time,"%A")),
           date_year=strftime(_time,"%Y")
    | lookup HOLIDAY_0 HOLIDAY_DAY AS date_mday, HOLIDAY_WEEK AS date_wday, HOLIDAY_MONTH AS date_month, HOLIDAY_YEAR AS date_year output HOLIDAY_CHECK
    | fillnull value="no" HOLIDAY_CHECK
    | search date_wday="monday" OR date_wday="tuesday" OR date_wday="wednesday" OR date_wday="thursday" OR date_wday="friday" OR date_wday="saturday" OR date_wday="sunday"
    | rename program.vod_id as vod_id,
             program.start_time as start_time,
             program.end_time as end_time,
             program.gonggam_ch_cd as ch,
             program.view_radio as view_radio,
             program.image as image,
             program.gorealraboard_url as board,
             program.aodurl as aod,
             program.musiclist as music,
             program.title as title,
             program.guestlist.guest.name as guestname,
             program.daily_corners as daily_corner,
             program.weekly_corners as weekly_corner
    | join type=left max=0 vod_id [
        | inputlookup BROADPLAN.csv
        | search IS_END="N"
        | rename VOD_ID AS vod_id
        | fields SEQ, vod_id, PD_NAME
    ]
    | fillnull value="" view_radio
    | search SEQ=F* OR SEQ=L* OR SEQ=M*
    | eval PGM_CODE=upper(SEQ)
    | eval join_key=DATE."||".PGM_CODE
    | stats values(title)         as program_title
            values(guestname)     as guestname
            values(daily_corner)  as daily_corner
            values(weekly_corner) as weekly_corner
      by join_key
    | fields join_key program_title guestname daily_corner weekly_corner
]

| fields - join_key

`comment("================================================================")`
`comment("=== [10] 최종 저장 필드 ===")`
`comment("================================================================")`

| table
    `comment("--- 기준 날짜 ---")`
